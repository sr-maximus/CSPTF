{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csptf.org/schemas/control.schema.json",
  "title": "CSPTF Control",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "domain_id",
    "domain_code",
    "title_es",
    "objective",
    "requirement",
    "minimum_profile",
    "evidence",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CSPTF-CTRL-[A-Z0-9]{2,4}-[0-9]{3}$"
    },
    "domain_id": {
      "type": "string",
      "pattern": "^CSPTF-DOM-[0-9]{2}$"
    },
    "domain_code": {
      "type": "string",
      "pattern": "^[A-Z0-9]{2,4}$"
    },
    "title_es": {
      "type": "string",
      "minLength": 3
    },
    "title_en": {
      "type": "string"
    },
    "objective": {
      "type": "string",
      "minLength": 20
    },
    "requirement": {
      "type": "string",
      "minLength": 20
    },
    "minimum_profile": {
      "enum": [
        "AP1",
        "AP2",
        "AP3",
        "AP4"
      ]
    },
    "evidence": {
      "type": "string",
      "minLength": 10
    },
    "owner_examples": {
      "type": "string"
    },
    "aadapt_tactics": {
      "type": "string"
    },
    "nist_csf2": {
      "type": "string"
    },
    "owasp_alignment": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "verified",
        "deprecated"
      ]
    }
  }
}
